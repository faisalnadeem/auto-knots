@model IEnumerable<AutoKnots.Models.InventoryItem>
@{
    ViewData["Title"] = "Inventory";
    var search = ViewBag.Search as string ?? "";
    var totalCount = (int)ViewBag.TotalCount;
    var page = (int)ViewBag.Page;
    var pageSize = (int)ViewBag.PageSize;
    var totalPages = (int)ViewBag.TotalPages;
}
<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Inventory</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item">Inventory</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex align-items-center gap-2 page-header-right-items-wrapper">
                <a asp-action="Add" class="btn btn-primary">
                    <i class="feather-plus me-2"></i>
                    <span>Add Inventory</span>
                </a>
            </div>
        </div>
    </div>
</div>
<!-- [ page-header ] end -->
<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="row">
        <div class="col-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Inventory List</h5>
                    <div class="card-header-action">
                        <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
                            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Search by name, make, model..." style="max-width: 260px;" />
                            <button type="submit" class="btn btn-sm btn-light-brand">
                                <i class="feather-search me-1"></i> Search
                            </button>
                            @if (!string.IsNullOrEmpty(search))
                            {
                                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                            }
                        </form>
                    </div>
                </div>
                <div class="card-body custom-card-action p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr class="border-b">
                                    <th scope="row">Name</th>
                                    <th>Make</th>
                                    <th>Model</th>
                                    <th>Variant</th>
                                    <th>Engine No.</th>
                                    <th>Chassis No.</th>
                                    <th>Cost Price</th>
                                    <th>Sale Price</th>
                                    <th>Purchased</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-action="Edit" asp-route-id="@item.Id">@item.Name</a>
                                            </td>
                                            <td>@item.Make</td>
                                            <td>@item.Model</td>
                                            <td>@(item.Variant ?? "—")</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.EngineNumber) ? "—" : item.EngineNumber)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.ChassisNumber) ? "—" : item.ChassisNumber)</td>
                                            <td>@item.CostPrice.ToString("N2")</td>
                                            <td>@item.SalePrice.ToString("N2")</td>
                                            <td>@(item.PurchaseDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-soft-success text-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-soft-secondary text-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light-brand me-1" title="Edit"><i class="feather-edit-2"></i></a>
                                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this item?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-light-danger" title="Delete"><i class="feather-trash-2"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-4">No vehicles found. <a asp-action="Add">Add one</a>.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (totalPages > 1)
                {
                    <div class="card-footer">
                        <ul class="list-unstyled d-flex align-items-center gap-2 mb-0 pagination-common-style flex-wrap">
                            <li>
                                @if (page > 1)
                                {
                                    <a asp-action="Index" asp-route-search="@search" asp-route-page="@(page - 1)"><i class="bi bi-arrow-left"></i></a>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-arrow-left"></i></span>
                                }
                            </li>
                            @for (var p = 1; p <= totalPages; p++)
                            {
                                <li>
                                    @if (p == page)
                                    {
                                        <a href="javascript:void(0);" class="active">@p</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Index" asp-route-search="@search" asp-route-page="@p">@p</a>
                                    }
                                </li>
                            }
                            <li>
                                @if (page < totalPages)
                                {
                                    <a asp-action="Index" asp-route-search="@search" asp-route-page="@(page + 1)"><i class="bi bi-arrow-right"></i></a>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-arrow-right"></i></span>
                                }
                            </li>
                        </ul>
                        <div class="fs-12 text-muted">Showing @((page - 1) * pageSize + 1) to @(Math.Min(page * pageSize, totalCount)) of @totalCount</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->
