@model AutoKnots.Models.InventoryItem
@{
    ViewData["Title"] = "Edit Inventory";
}
<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Edit Inventory</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Inventory</a></li>
            <li class="breadcrumb-item">Edit</li>
        </ul>
    </div>
</div>
<!-- [ page-header ] end -->
<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="row">
        <div class="col-xl-12">
            <div class="card stretch stretch-full">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Edit Vehicle</h5>
                    <div class="dropdown">
                        <button class="btn btn-light-brand dropdown-toggle" type="button" id="costingDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Costing
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="costingDropdown">
                            <li>
                                <a class="dropdown-item" asp-action="AddCost" asp-route-id="@Model.Id">Add Cost</a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-action="EditCosts" asp-route-id="@Model.Id">Edit Cost</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <form method="post" asp-action="Edit" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="row mb-4 align-items-center">
                            <div class="col-lg-4">
                                <label asp-for="Name" class="fw-semibold">Name: </label>
                            </div>
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="feather-package"></i></div>
                                    <input asp-for="Name" class="form-control" placeholder="Name" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger fs-12"></span>
                            </div>
                        </div>
                        <div class="row mb-4 align-items-center">
                            <div class="col-lg-4">
                                <label asp-for="Make" class="fw-semibold">Make: </label>
                            </div>
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="feather-truck"></i></div>
                                    <input asp-for="Make" class="form-control" placeholder="e.g. Toyota, Honda" />
                                </div>
                                <span asp-validation-for="Make" class="text-danger fs-12"></span>
                            </div>
                        </div>
                        <div class="row mb-4 align-items-center">
                            <div class="col-lg-4">
                                <label asp-for="Model" class="fw-semibold">Model: </label>
                            </div>
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="feather-box"></i></div>
                                    <input asp-for="Model" class="form-control" placeholder="e.g. Corolla, Civic" />
                                </div>
                                <span asp-validation-for="Model" class="text-danger fs-12"></span>
                            </div>
                        </div>
                        <div class="row mb-4 align-items-center">
                            <div class="col-lg-4">
                                <label asp-for="Variant" class="fw-semibold">Variant: </label>
                            </div>
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="feather-sliders"></i></div>
                                    <input asp-for="Variant" class="form-control" placeholder="Optional variant/trim" />
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4 align-items-center">
                            <div class="col-lg-4">
                                <label asp-for="EngineNumber" class="fw-semibold">Engine Number: </label>
                            </div>
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="feather-cpu"></i></div>
                                    <input asp-for="EngineNumber" class="form-control" placeholder="Engine number" />
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4 align-items-center">
                            <div class="col-lg-4">
                                <label asp-for="ChassisNumber" class="fw-semibold">Chassis Number: </label>
                            </div>
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="feather-hash"></i></div>
                                    <input asp-for="ChassisNumber" class="form-control" placeholder="Chassis number" />
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4 align-items-center">
                            <div class="col-lg-4">
                                <label asp-for="PurchaseDate" class="fw-semibold">Purchase Date: </label>
                            </div>
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="feather-calendar"></i></div>
                                    <input asp-for="PurchaseDate" class="form-control" type="date" />
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4 align-items-center">
                            <div class="col-lg-4">
                                <label asp-for="CostPrice" class="fw-semibold">Cost Price: </label>
                            </div>
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="feather-dollar-sign"></i></div>
                                    <input asp-for="CostPrice" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="CostPrice" class="text-danger fs-12"></span>
                            </div>
                        </div>
                        <div class="row mb-4 align-items-center">
                            <div class="col-lg-4">
                                <label asp-for="IsActive" class="fw-semibold">Active: </label>
                            </div>
                            <div class="col-lg-8">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                    <label asp-for="IsActive" class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>
                        <hr class="my-4" />
                        <div class="row mb-3">
                            <div class="col-12">
                                @{
                                    var investors = ViewBag.Investors as IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser> ?? Enumerable.Empty<Microsoft.AspNetCore.Identity.IdentityUser>();
                                }
                                <h6 class="fw-semibold mb-2">Investor Allocations</h6>
                                <p class="text-muted fs-12 mb-3">
                                    Update investor allocations for this vehicle. Enter either an amount or a percentage; the other will be calculated
                                    automatically based on the current cost price.
                                </p>
                                @if (investors.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Select</th>
                                                    <th>Investor</th>
                                                    <th>Email</th>
                                                    <th style="width: 160px;">Amount</th>
                                                    <th style="width: 160px;">Percentage %</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var inv in investors)
                                                {
                                                    var existing = Model.Investments.FirstOrDefault(x => x.InvestorUserId == inv.Id);
                                                    var existingAmountValue = existing != null ? existing.Amount.ToString("0.00") : string.Empty;
                                                    var existingPercentageValue = existing?.Percentage.HasValue == true
                                                        ? existing!.Percentage!.Value.ToString("0.00")
                                                        : string.Empty;
                                                    <tr>
                                                        <td>
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="investorIds" value="@inv.Id" id="inv_@inv.Id"
                                                                       @(existing != null ? "checked" : "") />
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <label class="mb-0" for="inv_@inv.Id">@inv.UserName</label>
                                                        </td>
                                                        <td>@inv.Email</td>
                                                        <td>
                                                            <input name="amount_@inv.Id" type="number" step="0.01" min="0"
                                                                   class="form-control form-control-sm"
                                                                   value="@existingAmountValue"
                                                                   placeholder="0.00" />
                                                        </td>
                                                        <td>
                                                            <input name="percentage_@inv.Id" type="number" step="0.01" min="0" max="100"
                                                                   class="form-control form-control-sm"
                                                                   value="@existingPercentageValue"
                                                                   placeholder="%" />
                                                        </td>
                                                        <td>
                                                            @if (existing != null)
                                                            {
                                                                switch (existing.Status)
                                                                {
                                                                    case AutoKnots.Models.InvestmentStatus.Approved:
                                                                        <span class="badge bg-soft-success text-success">Approved</span>
                                                                        break;
                                                                    case AutoKnots.Models.InvestmentStatus.Rejected:
                                                                        <span class="badge bg-soft-danger text-danger">Rejected</span>
                                                                        break;
                                                                    default:
                                                                        <span class="badge bg-soft-warning text-warning">Pending</span>
                                                                        break;
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-soft-secondary text-secondary">Not Set</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info mb-0">
                                        No other users are available as investors yet.
                                    </div>
                                }
                            </div>
                        </div>
                        <hr class="my-4" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="feather-save me-2"></i> Save
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->
@section Scripts {
    @* Client-side validation disabled so form always POSTs; server validates. *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggle = document.getElementById('costingDropdown');
            if (!toggle || typeof bootstrap === 'undefined') {
                return;
            }

            var dropdown = bootstrap.Dropdown.getOrCreateInstance(toggle);
            var wrapper = toggle.closest('.dropdown');
            if (!wrapper) {
                return;
            }

            wrapper.addEventListener('mouseenter', function () {
                dropdown.show();
            });

            wrapper.addEventListener('mouseleave', function () {
                dropdown.hide();
            });
        });
    </script>
}
