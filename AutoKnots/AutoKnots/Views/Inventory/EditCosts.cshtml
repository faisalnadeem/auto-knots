@model IEnumerable<AutoKnots.Models.InventoryCost>
@{
    ViewData["Title"] = "Edit Costs";
    var inventoryName = ViewBag.InventoryName as string ?? "Vehicle";
    var investorNames = ViewBag.InvestorNames as IDictionary<string, string> ?? new Dictionary<string, string>();
    bool isSold = ViewBag.IsSold as bool? ?? false;
}

<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Costs - @inventoryName</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Inventory</a></li>
            <li class="breadcrumb-item">Costs</li>
        </ul>
    </div>
</div>

<div class="main-content">
    <div class="row">
        <div class="col-xl-12">
            <div class="card stretch stretch-full">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Cost Entries</h5>
                    @if (!isSold)
                    {
                        <a asp-action="AddCost" asp-route-id="@((Model?.FirstOrDefault()?.InventoryItemId) ?? 0)" class="btn btn-light-brand">
                            Add Cost
                        </a>
                    }
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Investor</th>
                                    <th>Notes</th>
                                    <th>Created</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var cost in Model)
                                    {
                                        <tr>
                                            <td>@cost.Type</td>
                                            <td>@cost.Amount.ToString("N2")</td>
                                            <td>
                                                @{
                                                    string investorLabel = "—";
                                                    if (!string.IsNullOrEmpty(cost.InvestorUserId) && investorNames.TryGetValue(cost.InvestorUserId, out var name))
                                                    {
                                                        investorLabel = name;
                                                    }
                                                }
                                                @investorLabel
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(cost.Notes) ? "—" : cost.Notes)</td>
                                            <td>@cost.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                            <td class="text-end">
                                                @if (!isSold)
                                                {
                                                    <a asp-action="EditCost" asp-route-id="@cost.Id" class="btn btn-light-brand btn-icon" title="Edit">
                                                        <i class="feather-edit-2"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">No costs have been recorded for this vehicle yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

