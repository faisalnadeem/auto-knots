@model AutoKnots.Models.InvestorDashboardViewModel
@{
    ViewData["Title"] = "Pending Investments Approval";
}
<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Pending Investments Approval</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item">Pending Investments Approval</li>
        </ul>
    </div>
</div>
<!-- [ page-header ] end -->

<div class="main-content">
    <div class="row">
        <div class="col-xl-12">
            <div class="card mb-3">
                <div class="card-header py-2">
                    <h5 class="card-title mb-0">Pending Investments</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Car</th>
                                    <th>Make / Model</th>
                                    <th>Investment Amount</th>
                                    <th>Investment %</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PendingInvestments != null && Model.PendingInvestments.Any())
                                {
                                    foreach (var inv in Model.PendingInvestments)
                                    {
                                        <tr class="clickable-row" data-href="@Url.Action("Details", new { id = inv.Id })">
                                            <td>
                                                <a asp-action="Details" asp-route-id="@inv.Id">@inv.InventoryItem?.Name</a>
                                            </td>
                                            <td>@inv.InventoryItem?.Make @inv.InventoryItem?.Model</td>
                                            <td>@inv.Amount.ToString("N2")</td>
                                            <td>@(inv.Percentage.HasValue ? inv.Percentage.Value.ToString("N2") + "%" : "—")</td>
                                            <td><span class="badge bg-soft-warning text-warning">Pending</span></td>
                                            <td class="text-end">
                                                <div class="d-inline-flex flex-nowrap gap-1">
                                                    <form asp-action="Approve" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@inv.Id" />
                                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                                    </form>
                                                    <form asp-action="Reject" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@inv.Id" />
                                                        <input type="hidden" name="reason" value="Rejected by investor" />
                                                        <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">No pending investments.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title mb-0">Approved Investments</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Car</th>
                                    <th>Make / Model</th>
                                    <th>Investment Amount</th>
                                    <th>Investment %</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ApprovedInvestments != null && Model.ApprovedInvestments.Any())
                                {
                                    foreach (var inv in Model.ApprovedInvestments)
                                    {
                                        <tr class="clickable-row" data-href="@Url.Action("Details", new { id = inv.Id })">
                                            <td>
                                                <a asp-action="Details" asp-route-id="@inv.Id">@inv.InventoryItem?.Name</a>
                                            </td>
                                            <td>@inv.InventoryItem?.Make @inv.InventoryItem?.Model</td>
                                            <td>@inv.Amount.ToString("N2")</td>
                                            <td>@(inv.Percentage.HasValue ? inv.Percentage.Value.ToString("N2") + "%" : "—")</td>
                                            <td><span class="badge bg-soft-success text-success">Approved</span></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No approved investments yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

