@model AutoKnots.Models.InvestmentDetailsViewModel
@{
    ViewData["Title"] = "Investment Details";
}
<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Investment Details</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Investments">Pending Investments Approval</a></li>
            <li class="breadcrumb-item">Details</li>
        </ul>
    </div>
</div>
<!-- [ page-header ] end -->

<div class="main-content">
    <div class="row">
        <div class="col-xl-10">
            <div class="card stretch stretch-full mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Vehicle Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@Model.Item.Name</dd>

                        <dt class="col-sm-3">Make / Model</dt>
                        <dd class="col-sm-9">@Model.Item.Make @Model.Item.Model @Model.Item.Variant</dd>

                        <dt class="col-sm-3">Engine / Chassis</dt>
                        <dd class="col-sm-9">
                            Engine: @(string.IsNullOrWhiteSpace(Model.Item.EngineNumber) ? "—" : Model.Item.EngineNumber),
                            Chassis: @(string.IsNullOrWhiteSpace(Model.Item.ChassisNumber) ? "—" : Model.Item.ChassisNumber)
                        </dd>

                        <dt class="col-sm-3">Purchase Date</dt>
                        <dd class="col-sm-9">
                            @(Model.Item.PurchaseDate.HasValue
                                ? Model.Item.PurchaseDate.Value.ToString("dd MMM yyyy")
                                : "—")
                        </dd>

                        <dt class="col-sm-3">Cost Price</dt>
                        <dd class="col-sm-9">@Model.Item.CostPrice.ToString("N2")</dd>

                        <dt class="col-sm-3">Created By</dt>
                        <dd class="col-sm-9">@Model.CreatorEmail</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @switch (Model.Item.Status)
                            {
                                case AutoKnots.Models.InventoryStatus.Active:
                                    <span class="badge bg-soft-success text-success">Active</span>
                                    break;
                                case AutoKnots.Models.InventoryStatus.PendingApproval:
                                    <span class="badge bg-soft-warning text-warning">Pending Approval</span>
                                    break;
                                case AutoKnots.Models.InventoryStatus.Failed:
                                    <span class="badge bg-soft-danger text-danger">Failed</span>
                                    break;
                                default:
                                    <span class="badge bg-soft-secondary text-secondary">Draft</span>
                                    break;
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card stretch stretch-full mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Investors</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Investor</th>
                                    <th>Amount</th>
                                    <th>Percentage</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Participants != null && Model.Participants.Any())
                                {
                                    foreach (var p in Model.Participants)
                                    {
                                        <tr>
                                            <td>@p.InvestorEmail</td>
                                            <td>@p.Amount.ToString("N2")</td>
                                            <td>@(p.Percentage.HasValue ? p.Percentage.Value.ToString("N2") + "%" : "—")</td>
                                            <td>
                                                @switch (p.Status)
                                                {
                                                    case AutoKnots.Models.InvestmentStatus.Approved:
                                                        <span class="badge bg-soft-success text-success">Approved</span>
                                                        break;
                                                    case AutoKnots.Models.InvestmentStatus.Rejected:
                                                        <span class="badge bg-soft-danger text-danger">Rejected</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-soft-warning text-warning">Pending</span>
                                                        break;
                                                }
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(p.RejectReason) ? "—" : p.RejectReason)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No investors for this vehicle.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mb-4">
                <form asp-action="Approve" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CurrentInvestment.Id" />
                    <button type="submit" class="btn btn-success">
                        <i class="feather-check me-2"></i> Approve
                    </button>
                </form>
                <form asp-action="Reject" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CurrentInvestment.Id" />
                    <input type="hidden" name="reason" value="Rejected by investor" />
                    <button type="submit" class="btn btn-danger">
                        <i class="feather-x me-2"></i> Reject
                    </button>
                </form>
                <a href="/Investments" class="btn btn-outline-secondary ms-auto">Back to list</a>
            </div>
        </div>
    </div>
</div>

