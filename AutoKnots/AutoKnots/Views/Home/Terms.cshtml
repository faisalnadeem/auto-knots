@{
    ViewData["Title"] = "Terms of Use";
}

<style>
    .terms-icon {
        color: #000;
        font-size: 1.75rem;
        line-height: 1;
        margin-top: 0.15rem;
    }
</style>

<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Terms of Use</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item">Terms</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto"></div>
</div>
<!-- [ page-header ] end -->

<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="row">
        <!-- Hero / Intro -->
        <div class="col-12">
            <div class="card stretch stretch-full mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <div class="terms-icon">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <div>
                            <h3 class="fs-18 fw-bold mb-2">Welcome to Auto Knots</h3>
                            <p class="fs-13 text-muted mb-0">
                                By accessing or using this system, you agree to comply with and be bound by the following Terms of Use.
                            </p>
                        </div>
                    </div>

                    <div class="mt-3">
                        <p class="fs-13 text-muted mb-2">
                            These terms govern your use of the platform, including vehicle management, investor participation, cost tracking, and profit distribution.
                        </p>
                        <div class="alert alert-soft-warning-message mb-0">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-exclamation-circle-fill mt-1 text-dark"></i>
                                <div>
                                    If you do not agree with any part of these terms, you should not use the system.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sections -->
        <div class="col-12">
            <div class="row g-3">
                <!-- Definitions -->
                <div class="col-12">
                    <div class="card stretch stretch-full">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                <div class="terms-icon">
                                    <i class="bi bi-book"></i>
                                </div>
                                <div>
                                    <h5 class="fs-14 fw-semibold mb-2">Definitions</h5>
                                    <div class="text-muted fs-13">
                                        <p class="mb-2"><strong>Platform / System:</strong> Refers to Auto Knots</p>
                                        <p class="mb-2"><strong>User:</strong> Any individual using the system</p>
                                        <p class="mb-2"><strong>Owner / Creator:</strong> The user who creates a vehicle entry</p>
                                        <p class="mb-2"><strong>Investor:</strong> Any user contributing funds toward a vehicle</p>
                                        <p class="mb-2"><strong>Vehicle / Inventory Item:</strong> A car listed in the system for resale</p>
                                        <p class="mb-0"><strong>Investment:</strong> The amount contributed by an investor toward a vehicle</p>
                                        <p class="mb-0"><strong>Profit:</strong> The difference between selling price and total cost</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Responsibilities -->
                <div class="col-12">
                    <div class="p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="terms-icon">
                                <i class="bi bi-clipboard-check"></i>
                            </div>
                            <div>
                                <h5 class="fs-14 fw-semibold mb-2">User Responsibilities</h5>
                                <div class="text-muted fs-13">
                                    <p class="mb-2">By using Auto Knots, you agree that:</p>
                                    <ul class="mb-0 ps-3">
                                        <li>All information you enter (vehicle details, costs, investments) is accurate and truthful</li>
                                        <li>You are responsible for maintaining the confidentiality of your account</li>
                                        <li>You will not misuse the system for fraudulent or illegal activities</li>
                                        <li>You understand that financial decisions made using the platform are your own responsibility</li>
                                        <li>Auto Knots does not verify the authenticity of user-provided data.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Vehicle Management -->
                <div class="col-12">
                    <div class="card stretch stretch-full">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                <div class="terms-icon">
                                    <i class="bi bi-car-front"></i>
                                </div>
                                <div>
                                    <h5 class="fs-14 fw-semibold mb-2">Vehicle Management</h5>
                                    <div class="text-muted fs-13">
                                        <ul class="mb-0 ps-3">
                                            <li>Users can create and manage vehicles within the system</li>
                                            <li>The creator of a vehicle is considered the primary owner</li>
                                            <li>Once a vehicle is marked as Sold, it cannot be modified (including costs and financial data)</li>
                                            <li>Users are responsible for ensuring all vehicle-related data is correct before marking it as sold</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Investments -->
                <div class="col-12">
                    <div class="p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="terms-icon">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div>
                                <h5 class="fs-14 fw-semibold mb-2">Investments</h5>
                                <div class="text-muted fs-13">
                                    <ul class="mb-0 ps-3">
                                        <li>Users may add investors and assign investment amounts to a vehicle</li>
                                        <li>All investments may require approval from the respective investor</li>
                                        <li>Until approved, investments may be marked as Pending</li>
                                        <li>Rejected investments are excluded from profit calculations</li>
                                        <li>Each user is responsible for reviewing and confirming their investments.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Profit Calculation and Distribution -->
                <div class="col-12">
                    <div class="card stretch stretch-full">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                <div class="terms-icon">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </div>
                                <div>
                                    <h5 class="fs-14 fw-semibold mb-2">Profit Calculation and Distribution</h5>
                                    <div class="text-muted fs-13">
                                        <p class="mb-2">Profit is calculated as:</p>
                                        <div class="alert alert-soft-success-message mb-2">
                                            <strong>Profit</strong> = Selling Price - Total Cost
                                        </div>
                                        <ul class="mb-0 ps-3">
                                            <li>Profit distribution is based on each investor's percentage contribution</li>
                                            <li>The system automatically calculates and assigns profit shares</li>
                                            <li>In the absence of external investors, the vehicle creator receives 100% of the profit</li>
                                            <li>Auto Knots provides automated calculations, but users are responsible for verifying financial outcomes.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Financial Responsibility Disclaimer -->
                <div class="col-12">
                    <div class="p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="terms-icon">
                                <i class="bi bi-exclamation-circle-fill"></i>
                            </div>
                            <div>
                                <h5 class="fs-14 fw-semibold mb-2">Financial Responsibility Disclaimer</h5>
                                <div class="text-muted fs-13">
                                    <p class="mb-2"><strong>Auto Knots:</strong></p>
                                    <ul class="mb-0 ps-3">
                                        <li>Does not handle real money transactions</li>
                                        <li>Does not act as a financial institution, broker, or intermediary</li>
                                        <li>Does not guarantee profits or returns</li>
                                        <li>All financial arrangements, payments, and agreements between users (owners and investors) occur outside the platform and are solely the responsibility of the involved parties.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Data Integrity and Limitations -->
                <div class="col-12">
                    <div class="card stretch stretch-full">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                <div class="terms-icon">
                                    <i class="bi bi-shield-check"></i>
                                </div>
                                <div>
                                    <h5 class="fs-14 fw-semibold mb-2">Data Integrity and Limitations</h5>
                                    <div class="text-muted fs-13">
                                        <ul class="mb-0 ps-3">
                                            <li>The platform relies on user-input data</li>
                                            <li>Incorrect data entry may lead to inaccurate calculations</li>
                                            <li>Once a vehicle is marked as sold, financial data is locked to maintain integrity</li>
                                            <li>Users are encouraged to review all data before finalizing actions.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Access and Visibility -->
                <div class="col-12">
                    <div class="p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="terms-icon">
                                <i class="bi bi-eye"></i>
                            </div>
                            <div>
                                <h5 class="fs-14 fw-semibold mb-2">User Access and Visibility</h5>
                                <div class="text-muted fs-13">
                                    <p class="mb-0">
                                        Users can only view vehicles and profits related to them. This includes vehicles they created or invested in. The system maintains logical separation of data between users.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Prohibited Activities -->
                <div class="col-12">
                    <div class="card stretch stretch-full">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                <div class="terms-icon">
                                    <i class="bi bi-slash-circle"></i>
                                </div>
                                <div>
                                    <h5 class="fs-14 fw-semibold mb-2">Prohibited Activities</h5>
                                    <div class="text-muted fs-13">
                                        <p class="mb-2">Users agree not to:</p>
                                        <ul class="mb-0 ps-3">
                                            <li>Enter false or misleading financial data</li>
                                            <li>Manipulate investment values for unfair profit distribution</li>
                                            <li>Use the platform for illegal or unauthorized purposes</li>
                                            <li>Attempt to gain unauthorized access to other users' data</li>
                                            <li>Violation of these terms may result in restricted access or removal from the platform.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- System Availability -->
                <div class="col-12">
                    <div class="p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="terms-icon">
                                <i class="bi bi-arrow-repeat"></i>
                            </div>
                            <div>
                                <h5 class="fs-14 fw-semibold mb-2">System Availability</h5>
                                <div class="text-muted fs-13">
                                    <ul class="mb-0 ps-3">
                                        <li>While we aim to provide a reliable experience: the platform may undergo updates, maintenance, or downtime</li>
                                        <li>We do not guarantee uninterrupted or error-free operation</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Changes to Terms -->
                <div class="col-12">
                    <div class="card stretch stretch-full">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                <div class="terms-icon">
                                    <i class="bi bi-pencil-square"></i>
                                </div>
                                <div>
                                    <h5 class="fs-14 fw-semibold mb-2">Changes to Terms</h5>
                                    <div class="text-muted fs-13">
                                        <p class="mb-0">
                                            Auto Knots reserves the right to update or modify these Terms of Use at any time. Users are encouraged to review the terms periodically. Continued use of the platform constitutes acceptance of any changes.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Acceptance of Terms -->
                <div class="col-12">
                    <div class="p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="terms-icon">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div>
                                <h5 class="fs-14 fw-semibold mb-2">Acceptance of Terms</h5>
                                <div class="text-muted fs-13">
                                    <p class="mb-2">By using Auto Knots, you confirm that:</p>
                                    <ul class="mb-0 ps-3">
                                        <li>You understand how the system works</li>
                                        <li>You accept these terms in full</li>
                                        <li>You agree to use the platform responsibly</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /Sections -->
    </div>
</div>
<!-- [ Main Content ] end -->

