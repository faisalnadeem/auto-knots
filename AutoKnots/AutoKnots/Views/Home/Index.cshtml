@model AutoKnots.Models.ProfitsDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Profits";
    var monthLabels = Model.MonthlyProfits.Select(m => m.MonthLabel).ToList();
    var monthlyTotals = Model.MonthlyProfits.Select(m => (double)m.TotalProfit).ToList();
    var fromStr = Model.DateFrom?.ToString("yyyy-MM-dd");
    var toStr = Model.DateTo?.ToString("yyyy-MM-dd");
    var years = Enumerable.Range(DateTime.UtcNow.Year - 5, 6).ToList();
    var useCustomDate = Model.FilterYear == null && Model.FilterMonth == null && Model.DateFrom.HasValue && Model.DateTo.HasValue;
}

<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Profits</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item">Profits</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto">
        <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2" id="profits-filter-form">
            <span class="text-muted small me-1">Filter:</span>

            <!-- Month / Year filter (default) -->
            <div id="month-year-filter" class="d-flex align-items-center gap-2 flex-nowrap @(useCustomDate ? "d-none" : "")">
                <select name="year" class="form-select form-select-sm" style="max-width: 90px;">
                    <option value="">Year</option>
                    @foreach (var y in years)
                    {
                        if (Model.FilterYear == y && !useCustomDate)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
                <select name="month" class="form-select form-select-sm" style="max-width: 110px;">
                    <option value="">Month</option>
                    @for (var m = 1; m <= 12; m++)
                    {
                        var name = new DateTime(2000, m, 1).ToString("MMMM", CultureInfo.CurrentCulture);
                        if (Model.FilterMonth == m && !useCustomDate)
                        {
                            <option value="@m" selected>@name</option>
                        }
                        else
                        {
                            <option value="@m">@name</option>
                        }
                    }
                </select>
            </div>

            <!-- Custom date range filter (hidden by default) -->
            <div id="custom-date-filter" class="d-flex align-items-center gap-2 flex-nowrap @(useCustomDate ? "" : "d-none")">
                <input type="date" name="from" class="form-control form-control-sm" style="max-width: 140px;" value="@fromStr" placeholder="From" />
                <span class="text-muted">–</span>
                <input type="date" name="to" class="form-control form-control-sm" style="max-width: 140px;" value="@toStr" placeholder="To" />
            </div>

            <button type="button"
                    id="toggle-filter-mode"
                    class="btn btn-sm btn-outline-primary">
                @(useCustomDate ? "By month & year" : "Custom date")
            </button>

            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </form>
    </div>
</div>
<!-- [ page-header ] end -->
<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="row">
        <!-- Summary cards -->
        <div class="col-xxl-3 col-md-6">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div class="d-flex gap-3 align-items-center">
                            <div class="avatar-text avatar-lg bg-success bg-opacity-10 text-success">
                                <i class="feather-dollar-sign"></i>
                            </div>
                            <div>
                                <h3 class="fs-13 fw-semibold text-truncate-1-line text-muted">Total Profit</h3>
                                <div class="fs-4 fw-bold text-dark">@Model.TotalProfit.ToString("N2", CultureInfo.CurrentCulture)</div>
                            </div>
                        </div>
                    </div>
                    <p class="fs-12 text-muted mb-0">In selected period</p>
                </div>
            </div>
        </div>
        <div class="col-xxl-3 col-md-6">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div class="d-flex gap-3 align-items-center">
                            <div class="avatar-text avatar-lg bg-primary bg-opacity-10 text-primary">
                                <i class="feather-truck"></i>
                            </div>
                            <div>
                                <h3 class="fs-13 fw-semibold text-truncate-1-line text-muted">Sold Vehicles</h3>
                                <div class="fs-4 fw-bold text-dark">@Model.SoldCount</div>
                            </div>
                        </div>
                    </div>
                    <p class="fs-12 text-muted mb-0">Cars sold in period</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Profit by month chart -->
    <div class="row">
        <div class="col-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Profit by Month</h5>
                </div>
                <div class="card-body custom-card-action p-0">
                    <div id="profits-by-month-chart" style="min-height: 320px;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sold vehicles table -->
    <div class="row">
        <div class="col-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Sold Vehicles & Profit</h5>
                    <p class="text-muted fs-12 mb-0">Profit per vehicle (creator and investors). Click <strong>View details</strong> for breakdown.</p>
                </div>
                <div class="card-body p-0">
                    @if (Model.SoldVehicles.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">No sold vehicles in the selected period.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr class="border-b">
                                        <th>Vehicle</th>
                                        <th>Sale Date</th>
                                        <th>Cost / Sale</th>
                                        <th>Total Profit</th>
                                        <th>Investors (incl. creator)</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.SoldVehicles)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-semibold">@row.VehicleName</span>
                                            </td>
                                            <td>@row.SaleDate.ToString("d", CultureInfo.CurrentCulture)</td>
                                            <td>
                                                <span class="text-muted">@row.CostPrice.ToString("N2", CultureInfo.CurrentCulture)</span>
                                                <span class="mx-1">→</span>
                                                <span>@row.SalePrice.ToString("N2", CultureInfo.CurrentCulture)</span>
                                            </td>
                                            <td class="fw-semibold text-success">@row.TotalProfit.ToString("N2", CultureInfo.CurrentCulture)</td>
                                            <td>
                                                @if (row.InvestorProfits.Count > 0)
                                                {
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var inv in row.InvestorProfits)
                                                        {
                                                            <span class="badge bg-soft-primary text-primary" title="@inv.InvestorName: @inv.Amount.ToString("N2", CultureInfo.CurrentCulture) (@inv.Percentage%)">
                                                                @inv.InvestorName: @inv.Amount.ToString("N2", CultureInfo.CurrentCulture)
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a href="@row.DetailsUrl" class="btn btn-sm btn-outline-primary">View details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->

@section Scripts {
<script>
(function () {
    var categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthLabels));
    var seriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyTotals));
    if (categories.length === 0) {
        categories = ['No data'];
        seriesData = [0];
    }
    var options = {
        series: [{ name: 'Profit', data: seriesData }],
        chart: { type: 'bar', height: 320, toolbar: { show: false } },
        plotOptions: {
            bar: {
                horizontal: false,
                columnWidth: '55%',
                borderRadius: 4
            }
        },
        dataLabels: { enabled: false },
        stroke: { show: true, width: 2, colors: ['transparent'] },
        xaxis: { categories: categories },
        yaxis: { title: { text: 'Profit' } },
        fill: { opacity: 1 },
        colors: ['#0d6efd'],
        tooltip: {
            y: {
                formatter: function (val) {
                    return typeof val === 'number' ? val.toLocaleString('en', { minimumFractionDigits: 2 }) : val;
                }
            }
        }
    };
    var chart = new ApexCharts(document.querySelector('#profits-by-month-chart'), options);
    chart.render();
})();

(function () {
    var useCustom = @((useCustomDate ? "true" : "false").ToLower());
    var monthYearGroup = document.getElementById('month-year-filter');
    var customGroup = document.getElementById('custom-date-filter');
    var toggleBtn = document.getElementById('toggle-filter-mode');
    if (!monthYearGroup || !customGroup || !toggleBtn) {
        return;
    }

    function setMode(custom) {
        if (custom) {
            monthYearGroup.classList.add('d-none');
            customGroup.classList.remove('d-none');
            toggleBtn.textContent = 'By month & year';
            // Disable month/year inputs so only dates are submitted
            monthYearGroup.querySelectorAll('select').forEach(function (el) { el.disabled = true; });
            customGroup.querySelectorAll('input').forEach(function (el) { el.disabled = false; });
        } else {
            customGroup.classList.add('d-none');
            monthYearGroup.classList.remove('d-none');
            toggleBtn.textContent = 'Custom date';
            // Disable custom date inputs so only month/year are submitted
            customGroup.querySelectorAll('input').forEach(function (el) { el.disabled = true; });
            monthYearGroup.querySelectorAll('select').forEach(function (el) { el.disabled = false; });
        }
    }

    // Initial mode
    setMode(useCustom);

    toggleBtn.addEventListener('click', function () {
        useCustom = !useCustom;
        setMode(useCustom);
    });
})();
</script>
}
