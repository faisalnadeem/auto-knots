@{
    ViewData["Title"] = "Contact Support";
}

<style>
    .support-hero {
        position: relative;
        overflow: hidden;
        border: 1px solid #e6e8ef;
        border-radius: 16px;
        background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 55%, #0ea5e9 100%);
        color: #fff;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.2);
    }

    .support-hero::after {
        content: "";
        position: absolute;
        top: -40px;
        right: -60px;
        width: 220px;
        height: 220px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
    }

    .support-hero .hero-content {
        position: relative;
        z-index: 1;
    }

    .support-hero .hero-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 1.5rem;
        color: #fff;
    }

    .support-info-box {
        border: 1px solid #e9edf5;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.04);
    }

    .support-mail-link,
    .support-strong {
        font-weight: 700;
        font-size: 1rem;
    }
</style>

<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Contact Support</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item">Contact Support</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto"></div>
</div>
<!-- [ page-header ] end -->

<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="row g-4">
        <div class="col-12">
            <div class="support-hero p-4 p-md-5">
                <div class="hero-content d-flex align-items-start gap-3">
                    <div class="hero-icon">
                        <i class="bi bi-life-preserver"></i>
                    </div>
                    <div>
                        <h3 class="mb-2 text-white">We're here to help!</h3>
                        <p class="mb-0 fs-13 text-white">
                            Send us your questions or feedback and we'll get back to you soon through email.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-body p-4">
                    <h4 class="mb-2">How can we support you?</h4>
                    <p class="text-muted mb-4">
                        Submit the form below and our team will get back to you.
                    </p>

                    @if (TempData["SupportSuccess"] is string successMessage)
                    {
                        <div class="alert alert-soft-success-message mb-3">@successMessage</div>
                    }
                    @if (TempData["SupportError"] is string errorMessage)
                    {
                        <div class="alert alert-soft-danger-message mb-3">@errorMessage</div>
                    }

                    <form asp-action="Help" asp-controller="Home" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold" for="fullName">Full Name</label>
                                <input id="fullName" name="fullName" type="text" class="form-control" placeholder="Enter your name" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold" for="email">Email</label>
                                <input id="email" name="email" type="email" class="form-control" placeholder="Enter your email" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold" for="subject">Subject</label>
                                <input id="subject" name="subject" type="text" class="form-control" placeholder="What do you need help with?" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold" for="message">Message</label>
                                <textarea id="message" name="message" class="form-control" rows="6" placeholder="Write your message..." required></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-dark px-4">Submit Request</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <div class="support-info-box p-4 h-100">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-envelope-fill text-dark"></i>
                            <h5 class="mb-0">Email Support</h5>
                        </div>
                        <p class="text-muted mb-3">For general inquiries and support</p>
                        <a class="support-mail-link" href="mailto:autoknots@gmail.com">autoknots@gmail.com</a>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="support-info-box p-4 h-100">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-clock-fill text-dark"></i>
                            <h5 class="mb-0">Response Time</h5>
                        </div>
                        <p class="text-muted mb-2">We typically respond within 24 hours</p>
                        <p class="support-strong mb-0">Monday - Friday, 9 AM - 6 PM</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->
