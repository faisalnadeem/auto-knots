@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Browse quality vehicles for sale on AutoKnots.")" />
    @if (ViewData["Canonical"] is string canonical) { <link rel="canonical" href="@canonical" /> }
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Browse quality vehicles for sale on AutoKnots.")" />
    @if (ViewData["Canonical"] is string ogUrl) { <meta property="og:url" content="@ogUrl" /> }
    @if (ViewData["OgImage"] is string ogImage) { <meta property="og:image" content="@ogImage" /> }
    <link rel="shortcut icon" href="~/assets/images/logo-abbr.png" />
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendors/css/vendors.min.css" />
    <link rel="stylesheet" href="~/assets/css/theme.min.css" />
    <style>
        body { background:#f8fafc; color:#16324f; }
        .public-nav { background:#fff; border-bottom:1px solid #e2e8f0; }
        .public-nav .navbar-brand img { height:38px; max-width:180px; object-fit:contain; }
        .market-hero { background:linear-gradient(120deg,#16324f,#2563eb); color:#fff; border-radius:0 0 2rem 2rem; }
        .vehicle-card { border:0; box-shadow:0 8px 28px rgba(15,23,42,.08); transition:transform .2s ease; }
        .vehicle-card:hover { transform:translateY(-3px); }
        .vehicle-photo { width:100%; height:230px; object-fit:cover; background:#e2e8f0; }
        .public-footer { background:#16324f; color:#dbeafe; }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<nav class="navbar navbar-expand-lg public-nav sticky-top">
    <div class="container py-2">
        <a class="navbar-brand" href="/marketplace"><img src="~/assets/images/logo-full.png" alt="AutoKnots" /></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="publicNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="/marketplace">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/cars">Browse Vehicles</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/Terms">About</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/Help">Contact</a></li>
                @if (SignInManager.IsSignedIn(User)) {
                    <li class="nav-item"><a class="nav-link" href="/Inventory">My Inventory</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Marketplace/Mine">Sell</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Investments">Dashboard</a></li>
                }
            </ul>
            <div class="d-flex gap-2">
                @if (SignInManager.IsSignedIn(User)) { <a class="btn btn-primary" href="/">Open Dashboard</a> }
                else { <a class="btn btn-outline-primary" href="/auth-login-cover.html">Sign In</a><a class="btn btn-primary" href="/auth-register-cover.html">Register</a> }
            </div>
        </div>
    </div>
</nav>
<main>@RenderBody()</main>
<footer class="public-footer mt-5"><div class="container py-4 d-flex flex-wrap justify-content-between"><span>© @DateTime.UtcNow.Year AutoKnots</span><span>Find your next vehicle with confidence.</span></div></footer>
<script src="~/assets/vendors/js/vendors.min.js"></script>
<script src="~/assets/js/bootstrap.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
