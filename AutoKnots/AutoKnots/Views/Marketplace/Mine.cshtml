@model AutoKnots.Models.MarketplacePage
@using AutoKnots.Models
@{ ViewData["Title"] = "My Listings"; }
<div class="page-header"><div class="page-header-left"><div class="page-header-title"><h5>My Listings</h5></div></div><div class="page-header-right ms-auto"><a asp-action="Create" class="btn btn-primary">Create listing</a></div></div>
<div class="main-content">@if(TempData["SuccessMessage"] != null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}@if(TempData["ErrorMessage"] != null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}<div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Listing</th><th>Price</th><th>Status</th><th>Published</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Title<br/><small class="text-muted">@item.Year @item.Make @item.Model</small></td><td>@item.Price.ToString("C")</td><td><span class="badge bg-soft-primary text-primary">@item.Status</span></td><td>@(item.PublishedAt?.ToString("dd MMM yyyy") ?? "—")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>@if(item.Status == ListingStatus.Active){<form method="post" asp-action="SetStatus" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="status" value="Paused"/><button class="btn btn-sm btn-outline-warning">Pause</button></form>}else if(item.Status is ListingStatus.Draft or ListingStatus.Paused){<form method="post" asp-action="SetStatus" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="status" value="Active"/><button class="btn btn-sm btn-outline-success">Activate</button></form>}@if(item.Status is ListingStatus.Active or ListingStatus.Paused){<form method="post" asp-action="SetStatus" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="status" value="Sold"/><button class="btn btn-sm btn-outline-secondary">Mark sold</button></form>}@if(item.Status is not (ListingStatus.Sold or ListingStatus.Removed)){<form method="post" asp-action="Remove" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-danger">Remove</button></form>}</td></tr>}</tbody></table></div>@if(!Model.Items.Any()){<div class="card-body text-center text-muted py-5">You have no marketplace listings.</div>}</div></div>
