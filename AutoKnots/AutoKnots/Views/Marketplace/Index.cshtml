@model AutoKnots.Models.PublicMarketplacePage
@using AutoKnots.Models
@{ Layout = "_PublicLayout"; ViewData["Title"] = "Vehicles for Sale | AutoKnots"; ViewData["MetaDescription"] = "Search and compare active vehicle listings by make, model, price, mileage, condition and location."; ViewData["Canonical"] = Url.Action("Index", "Marketplace", null, ViewContext.HttpContext.Request.Scheme); var search = (MarketplaceSearch)ViewBag.Search; var featured = (IReadOnlyList<PublicListingSummary>)ViewBag.Featured; var popularMakes = (IReadOnlyList<string>)ViewBag.PopularMakes; var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize); }
<section class="market-hero"><div class="container py-5"><div class="row align-items-center py-lg-4"><div class="col-lg-7"><span class="badge bg-light text-primary mb-3">PUBLIC VEHICLE MARKETPLACE</span><h1 class="display-5 fw-bold">Find the right car, clearly.</h1><p class="lead text-white-50">Browse active listings, compare specifications and review inspection information before you sign in.</p></div><div class="col-lg-5"><form method="get" action="/cars" class="bg-white rounded-4 p-3 shadow"><label class="text-dark fw-semibold mb-2" for="heroSearch">Search vehicles</label><div class="input-group"><input id="heroSearch" name="Search" class="form-control" placeholder="BMW M3, Toyota Corolla…" value="@search.Search"/><button class="btn btn-primary">Search</button></div></form></div></div></div></section>
<div class="container py-5">
@if (featured.Any()) { <section class="mb-5"><div class="d-flex justify-content-between align-items-end mb-3"><div><div class="text-primary fw-semibold">HAND-PICKED</div><h2 class="mb-0">Featured vehicles</h2></div></div><div class="row g-4">@foreach(var item in featured){<partial name="_PublicListingCard" model="item"/>}</div></section> }
<section><div class="row g-4"><aside class="col-lg-3"><form method="get" action="/cars" class="card border-0 shadow-sm"><div class="card-body"><h5>Filter vehicles</h5><div class="mb-3"><label class="form-label">Make</label><input name="Make" value="@search.Make" class="form-control" /></div><div class="mb-3"><label class="form-label">Model</label><input name="Model" value="@search.Model" class="form-control" /></div><div class="row g-2 mb-3"><div class="col-6"><label class="form-label">Min year</label><input name="MinYear" value="@search.MinYear" class="form-control" /></div><div class="col-6"><label class="form-label">Max year</label><input name="MaxYear" value="@search.MaxYear" class="form-control" /></div></div><div class="row g-2 mb-3"><div class="col-6"><label class="form-label">Min price</label><input name="MinPrice" value="@search.MinPrice" class="form-control" /></div><div class="col-6"><label class="form-label">Max price</label><input name="MaxPrice" value="@search.MaxPrice" class="form-control" /></div></div><div class="mb-3"><label class="form-label">Max mileage</label><input name="MaxMileage" value="@search.MaxMileage" class="form-control" /></div><div class="mb-3"><label class="form-label">Fuel</label><select name="FuelType" asp-items="Html.GetEnumSelectList<FuelType>()" class="form-select"><option value="">Any</option></select></div><div class="mb-3"><label class="form-label">Transmission</label><select name="Transmission" asp-items="Html.GetEnumSelectList<TransmissionType>()" class="form-select"><option value="">Any</option></select></div><div class="mb-3"><label class="form-label">Body type</label><select name="BodyStyle" asp-items="Html.GetEnumSelectList<BodyStyle>()" class="form-select"><option value="">Any</option></select></div><div class="mb-3"><label class="form-label">Condition</label><select name="Condition" asp-items="Html.GetEnumSelectList<VehicleCondition>()" class="form-select"><option value="">Any</option></select></div><div class="mb-3"><label class="form-label">Location</label><input name="Location" value="@search.Location" class="form-control" /></div><button class="btn btn-primary w-100">Apply filters</button><a href="/cars" class="btn btn-link w-100">Clear</a></div></form><div class="mt-4"><h6>Popular makes</h6><div class="d-flex flex-wrap gap-2">@foreach(var make in popularMakes){<a href="/cars?Make=@Uri.EscapeDataString(make)" class="badge bg-light text-dark text-decoration-none p-2">@make</a>}</div></div></aside>
<div class="col-lg-9"><div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><div><h2 class="mb-1">Latest listings</h2><span class="text-muted">@Model.TotalCount active vehicles</span></div><form method="get" action="/cars"><input type="hidden" name="Search" value="@search.Search"/><input type="hidden" name="Make" value="@search.Make"/><input type="hidden" name="Model" value="@search.Model"/><select name="Sort" class="form-select" onchange="this.form.submit()"><option value="newest">Newest</option><option value="price_desc">Price: high to low</option><option value="price_asc">Price: low to high</option><option value="mileage_asc">Mileage: low to high</option><option value="mileage_desc">Mileage: high to low</option><option value="year_desc">Year: newest</option><option value="year_asc">Year: oldest</option></select></form></div><div class="row g-4">@foreach(var item in Model.Items){<partial name="_PublicListingCard" model="item"/>}</div>@if(!Model.Items.Any()){<div class="card border-0"><div class="card-body text-center py-5"><h4>No vehicles found</h4><p class="text-muted">Try widening your filters.</p><a href="/cars" class="btn btn-outline-primary">View all vehicles</a></div></div>}@if(totalPages > 1){<nav class="mt-4" aria-label="Marketplace pages"><ul class="pagination justify-content-center">@for(var p=1;p<=totalPages;p++){<li class="page-item @(p==Model.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@search.Search" asp-route-make="@search.Make" asp-route-model="@search.Model" asp-route-sort="@search.Sort">@p</a></li>}</ul></nav>}</div></div></section>
<section class="bg-white rounded-4 p-4 p-lg-5 mt-5 text-center shadow-sm"><h2>Ready to buy or sell?</h2><p class="text-muted">Create an account to save vehicles, contact sellers, arrange inspections and manage your own listings.</p><a href="/auth-register-cover.html?returnUrl=%2Fmarketplace" class="btn btn-primary me-2">Create account</a><a href="/auth-login-cover.html?returnUrl=%2Fmarketplace" class="btn btn-outline-primary">Sign in</a></section>
</div>
