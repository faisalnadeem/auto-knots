@model AutoKnots.Models.PublicListingDetails
@using System.Text.Json
@{ var Context = ViewContext.HttpContext; }
@{ Layout = "_PublicLayout"; var canonical = Url.Action("Details", "Marketplace", new { slug = Model.Slug }, Context.Request.Scheme)!; var returnUrl = Context.Request.Path + Context.Request.QueryString; var loginUrl = "/auth-login-cover.html?returnUrl=" + Uri.EscapeDataString(returnUrl); var registerUrl = "/auth-register-cover.html?returnUrl=" + Uri.EscapeDataString(returnUrl); ViewData["Title"] = $"{Model.Year} {Model.Make} {Model.Model} for Sale | AutoKnots"; ViewData["MetaDescription"] = $"{Model.Year} {Model.Make} {Model.Model}, {Model.Mileage:N0} miles, {Model.FuelType}, available in {Model.Location}."; ViewData["Canonical"] = canonical; ViewData["OgType"] = "product"; ViewData["OgImage"] = Model.PrimaryImageUrl; var schema = new Dictionary<string, object?> { ["@context"] = "https://schema.org", ["@type"] = "Vehicle", ["name"] = Model.Title, ["description"] = Model.Description, ["image"] = Model.ImageUrls, ["vehicleModelDate"] = Model.Year.ToString(), ["manufacturer"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = Model.Make }, ["model"] = Model.Model, ["mileageFromOdometer"] = new Dictionary<string, object?> { ["@type"] = "QuantitativeValue", ["value"] = Model.Mileage, ["unitCode"] = "SMI" }, ["fuelType"] = Model.FuelType.ToString(), ["vehicleTransmission"] = Model.Transmission.ToString(), ["itemCondition"] = Model.Condition.ToString(), ["offers"] = new Dictionary<string, object?> { ["@type"] = "Offer", ["price"] = Model.Price, ["priceCurrency"] = "GBP", ["availability"] = "https://schema.org/InStock", ["url"] = canonical } }; }
@section Head { <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(schema))</script> }
<div class="container py-4"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/marketplace">Marketplace</a></li><li class="breadcrumb-item"><a href="/cars?Make=@Uri.EscapeDataString(Model.Make)">@Model.Make</a></li><li class="breadcrumb-item active">@Model.Model</li></ol></nav><div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm overflow-hidden">@if(Model.ImageUrls.Any()){<img src="@Model.ImageUrls[0]" alt="@Model.Title" class="w-100" style="max-height:560px;object-fit:cover" decoding="async" width="1200" height="675"/> if(Model.ImageUrls.Count>1){<div class="row g-2 p-2">@foreach(var image in Model.ImageUrls.Skip(1)){<div class="col-4"><img src="@image" alt="@Model.Title" class="w-100 rounded" style="height:140px;object-fit:cover" loading="lazy" decoding="async" width="400" height="225"/></div>}</div>}}</div><div class="card border-0 shadow-sm mt-4"><div class="card-body p-4"><h2>Description</h2><p style="white-space:pre-line">@Model.Description</p>@if(Model.Features.Any()){<h3 class="h5 mt-4">Features</h3><div class="row">@foreach(var feature in Model.Features){<div class="col-md-6 mb-2"><i class="feather-check-circle text-success me-2"></i>@feature</div>}</div>}@if(!string.IsNullOrWhiteSpace(Model.VehicleHistory)){<h3 class="h5 mt-4">Vehicle history</h3><p style="white-space:pre-line">@Model.VehicleHistory</p>}</div></div><div class="card border-0 shadow-sm mt-4"><div class="card-body p-4"><h2 class="h4">Inspection</h2><div class="d-flex align-items-center gap-3"><span class="badge bg-soft-primary text-primary fs-6">@Model.InspectionStatus</span><span>@(Model.InspectionSummary ?? "No inspection report summary is currently available.")</span></div></div></div></div><aside class="col-lg-4"><div class="card border-0 shadow-sm sticky-top" style="top:90px"><div class="card-body p-4"><div class="text-muted">Listed @Model.PublishedAt.ToString("dd MMM yyyy")</div><h1 class="h3 mt-2">@Model.Title</h1><div class="display-6 fw-bold text-primary my-3">@Model.Price.ToString("C0")</div><dl class="row small"><dt class="col-6">Year</dt><dd class="col-6">@Model.Year</dd><dt class="col-6">Mileage</dt><dd class="col-6">@Model.Mileage.ToString("N0") miles</dd><dt class="col-6">Fuel</dt><dd class="col-6">@Model.FuelType</dd><dt class="col-6">Transmission</dt><dd class="col-6">@Model.Transmission</dd><dt class="col-6">Body type</dt><dd class="col-6">@Model.BodyStyle</dd><dt class="col-6">Condition</dt><dd class="col-6">@Model.Condition</dd><dt class="col-6">Location</dt><dd class="col-6">@Model.Location</dd></dl>@if(Model.SellerName != null){<hr/><div class="small text-muted">Seller</div><div class="fw-semibold">@Model.SellerName</div>}<hr/><div class="d-grid gap-2"><a href="@loginUrl" class="btn btn-primary">Contact seller</a><a href="@loginUrl" class="btn btn-outline-primary">Make an offer</a><a href="@loginUrl" class="btn btn-outline-primary">Purchase vehicle</a><a href="@loginUrl" class="btn btn-outline-secondary">Save vehicle</a><a href="@loginUrl" class="btn btn-outline-secondary">Add to favourites</a><a href="@loginUrl" class="btn btn-outline-secondary">Book inspection</a></div><div class="text-center small text-muted mt-3">New here? <a href="@registerUrl">Register</a> and return to this vehicle.</div></div></div></aside></div></div>
