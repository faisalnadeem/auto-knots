@model AutoKnots.Models.MarketplaceListingDetails
@{ ViewData["Title"] = Model.Title; }
<div class="page-header"><div class="page-header-left"><div class="page-header-title"><h5>@Model.Title</h5></div></div><div class="page-header-right ms-auto"><a asp-action="Index" class="btn btn-outline-secondary">Back to marketplace</a></div></div>
<div class="main-content"><div class="row g-4"><div class="col-lg-8"><div class="card"><div class="card-body">@if(Model.ImageUrls.Any()){<img src="@Model.ImageUrls[0]" alt="@Model.Title" class="img-fluid rounded w-100 mb-3" style="max-height:520px;object-fit:cover" />}<h4>Description</h4><p style="white-space:pre-line">@Model.Description</p></div></div></div><div class="col-lg-4"><div class="card"><div class="card-body"><h3 class="text-primary">@Model.Price.ToString("C")</h3><hr/><dl class="row"><dt class="col-6">Vehicle</dt><dd class="col-6">@Model.Year @Model.Make @Model.Model</dd><dt class="col-6">Mileage</dt><dd class="col-6">@Model.Mileage.ToString("N0") miles</dd><dt class="col-6">Fuel</dt><dd class="col-6">@Model.FuelType</dd><dt class="col-6">Transmission</dt><dd class="col-6">@Model.Transmission</dd><dt class="col-6">Body</dt><dd class="col-6">@Model.BodyStyle</dd><dt class="col-6">Condition</dt><dd class="col-6">@Model.Condition</dd><dt class="col-6">Location</dt><dd class="col-6">@Model.Location</dd></dl><hr/><div class="small text-muted">Seller</div><div class="fw-semibold">@Model.SellerName</div><button class="btn btn-primary w-100 mt-3" disabled>Contact seller (coming next)</button></div></div></div></div></div>
