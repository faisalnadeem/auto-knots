@model AutoKnots.Models.PublicListingSummary
<div class="col-md-6 col-xl-4"><article class="card vehicle-card h-100">@if(Model.PrimaryImageUrl != null){<img src="@Model.PrimaryImageUrl" alt="@Model.Title" class="vehicle-photo card-img-top" loading="lazy" decoding="async" width="640" height="360"/>}else{<div class="vehicle-photo d-flex align-items-center justify-content-center text-muted"><i class="feather-image fs-1"></i></div>}<div class="card-body d-flex flex-column"><div class="d-flex justify-content-between gap-2"><span class="badge bg-light text-dark">@Model.Condition</span><span class="small text-muted">@Model.InspectionStatus</span></div><h5 class="mt-3 mb-1">@Model.Title</h5><div class="text-muted small">@Model.Year @Model.Make @Model.Model</div><div class="d-flex flex-wrap gap-3 small mt-3"><span>@Model.Mileage.ToString("N0") miles</span><span>@Model.FuelType</span><span>@Model.Transmission</span></div><div class="small text-muted mt-2"><i class="feather-map-pin"></i> @Model.Location</div><div class="mt-auto pt-3 d-flex justify-content-between align-items-center"><strong class="fs-4 text-primary">@Model.Price.ToString("C0")</strong><a href="/cars/@Model.Slug" class="btn btn-outline-primary" aria-label="View @Model.Title">View</a></div></div></article></div>
